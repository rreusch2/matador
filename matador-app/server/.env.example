# Copy to server/.env and fill in. Never commit .env.

PORT=4000
# Browser origins allowed to call the API (Expo web). Native apps are always allowed.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Same values as the app's .env (Supabase > Project Settings > API Keys).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# xAI console > API Keys. Stays on the server only.
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx
XAI_MODEL=grok-4.3
# none | low | medium | high  (lower = faster)
XAI_REASONING_EFFORT=low

# Max generated workouts per user per rolling 24 hours.
WORKOUT_DAILY_LIMIT=20
