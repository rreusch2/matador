# Copy to .env.local and fill in from Supabase > Project Settings > API Keys.
# The publishable key (sb_publishable_...) or legacy anon key is safe to ship in the app.
# NEVER put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
